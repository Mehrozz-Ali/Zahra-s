# Address of the API, including /api/v1
# Production example: https://api.example.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Only if the shop and the API are on different domains (for example vercel.app and onrender.com):
# the real API origin, with no /api/v1. Then set NEXT_PUBLIC_API_URL=/api/v1 so the browser calls the shop's own address.
# API_PROXY_TARGET=https://your-api.onrender.com

# Address of the shop itself (used for links, the sitemap and sharing previews)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe publishable key (starts with pk_). This one is safe in the browser; never put a secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
