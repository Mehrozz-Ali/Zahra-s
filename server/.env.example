# ---- Server ----
PORT=8000
NODE_ENV=development            # use "production" on the server

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/women-clothing-store
# Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/women-clothing-store?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/women-clothing-store
# If an Atlas mongodb+srv:// address fails with "querySrv ECONNREFUSED", uncomment this line:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- Login tokens ----
# At least 32 random characters. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# ---- Website address ----
# Where the shop is open in the browser. Several addresses can be separated by commas.
# Production must be https, e.g. https://www.example.com,https://example.com
CLIENT_URL=http://localhost:3000

# ---- Cloudinary (product, category and profile pictures) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Stripe (card payments). Leave empty to offer cash on delivery only ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=          # required in production when STRIPE_SECRET_KEY is set
STRIPE_CURRENCY=pkr

# ---- Email (order, verification and password-reset emails). Leave empty to skip sending ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Zahra's <hello@example.com>"

# ---- Redis (optional, reserved for caching; the app does not need it today) ----
REDIS_URL=

# ---- Seed: the first admin account (npm run seed). Choose your own, never share it ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Password for the sample customers created by `npm run seed` in development (default Demo@12345)
SEED_DEMO_PASSWORD=
